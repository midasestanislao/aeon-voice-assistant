# Copy this file to .env and fill in the values.

# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Voicebox server (speech-to-text and text-to-speech)
VOICEBOX_URL=http://127.0.0.1:17493
# Voicebox checkout used by scripts/start_voicebox.ps1 (relative to this project, or absolute)
# VOICEBOX_DIR=voicebox

# Optional overrides (any field in config.py works: FIELD_NAME=value)
# LLM_MODEL=openai/gpt-4o
# VOICE_ES=em_alex
# VOICE_EN=af_heart
# WHISPER_MODEL=turbo
